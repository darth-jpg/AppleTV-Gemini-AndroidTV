<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_margin="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/tile_frame"
        android:layout_width="114dp"
        android:layout_height="64dp"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:background="@drawable/tile_card_base"
        android:focusable="true">

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Specular Focus Border Overlay (drawn OVER the banner so the white ring is never hidden) -->
        <View
            android:id="@+id/tile_focus_stroke"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tile_focus_overlay"
            android:duplicateParentState="true" />
    </FrameLayout>

    <!-- Label is hidden (alpha=0) by default; smoothly fades in on focus -->
    <TextView
        android:id="@+id/tile_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:maxLines="1"
        android:alpha="0"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:shadowDy="2" />
</LinearLayout>
