<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dock_item_frame"
    android:layout_width="114dp"
    android:layout_height="64dp"
    android:layout_margin="5dp"
    android:focusable="true"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:background="@drawable/tile_card_base">

    <ImageView
        android:id="@+id/dock_item_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Specular Focus Border Overlay (drawn OVER the banner so the white ring is never hidden) -->
    <View
        android:id="@+id/dock_item_focus_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tile_focus_overlay"
        android:duplicateParentState="true" />
</FrameLayout>
